FROM node:22.23.3-alpine3.23 AS deps
RUN apk upgrade --no-cache
WORKDIR /app
COPY apps/enterprise-portal/package.json apps/enterprise-portal/package-lock.json ./
RUN npm ci
# Dependency audit is enforced against every lockfile by the release workflow.

FROM node:22.23.3-alpine3.23 AS builder
RUN apk upgrade --no-cache
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY apps/enterprise-portal ./
RUN mkdir -p public
ARG NEXT_PUBLIC_CHAIN_ID=31337
ENV NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID
ARG NEXT_PUBLIC_RPC_URL=http://localhost:8545
ENV NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL
ARG NEXT_PUBLIC_JOB_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
ENV NEXT_PUBLIC_JOB_REGISTRY_ADDRESS=$NEXT_PUBLIC_JOB_REGISTRY_ADDRESS
ARG NEXT_PUBLIC_TAX_POLICY_ADDRESS=0x0000000000000000000000000000000000000000
ENV NEXT_PUBLIC_TAX_POLICY_ADDRESS=$NEXT_PUBLIC_TAX_POLICY_ADDRESS
ARG NEXT_PUBLIC_CERTIFICATE_NFT_ADDRESS=0x0000000000000000000000000000000000000000
ENV NEXT_PUBLIC_CERTIFICATE_NFT_ADDRESS=$NEXT_PUBLIC_CERTIFICATE_NFT_ADDRESS
ARG NEXT_PUBLIC_VALIDATION_MODULE_ADDRESS=0x0000000000000000000000000000000000000000
ENV NEXT_PUBLIC_VALIDATION_MODULE_ADDRESS=$NEXT_PUBLIC_VALIDATION_MODULE_ADDRESS
ARG NEXT_PUBLIC_STAKE_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
ENV NEXT_PUBLIC_STAKE_MANAGER_ADDRESS=$NEXT_PUBLIC_STAKE_MANAGER_ADDRESS
ARG NEXT_PUBLIC_STAKING_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
ENV NEXT_PUBLIC_STAKING_TOKEN_ADDRESS=$NEXT_PUBLIC_STAKING_TOKEN_ADDRESS
ARG NEXT_PUBLIC_STAKING_TOKEN_SYMBOL=AGIALPHA
ENV NEXT_PUBLIC_STAKING_TOKEN_SYMBOL=$NEXT_PUBLIC_STAKING_TOKEN_SYMBOL
ARG NEXT_PUBLIC_SUBGRAPH_URL=
ENV NEXT_PUBLIC_SUBGRAPH_URL=$NEXT_PUBLIC_SUBGRAPH_URL
ARG NEXT_PUBLIC_SPECIFICATION_ORIGINS=
ENV NEXT_PUBLIC_SPECIFICATION_ORIGINS=$NEXT_PUBLIC_SPECIFICATION_ORIGINS
ARG NEXT_PUBLIC_SPECIFICATION_GATEWAY=https://ipfs.io/ipfs
ENV NEXT_PUBLIC_SPECIFICATION_GATEWAY=$NEXT_PUBLIC_SPECIFICATION_GATEWAY
RUN npm run build

FROM node:22.23.3-alpine3.23 AS runner
RUN apk upgrade --no-cache
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000
COPY apps/enterprise-portal/package.json apps/enterprise-portal/package-lock.json ./
RUN npm ci --omit=dev
COPY --from=builder --chown=node:node /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.mjs ./next.config.mjs
USER node
EXPOSE 3000
CMD ["npm", "run", "start"]
