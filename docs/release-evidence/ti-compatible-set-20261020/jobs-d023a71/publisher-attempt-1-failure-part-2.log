2026-10-20T21:06:14.2387491Z                 '\n' +
2026-10-20T21:06:14.2387656Z +               '@app.route("/user_picture3")\n' +
2026-10-20T21:06:14.2387801Z +               'def user_picture3():\n' +
2026-10-20T21:06:14.2387988Z +               "    base_path = '/server/static/images'\n" +
2026-10-20T21:06:14.2388165Z +               "    filename = request.args.get('p')\n" +
2026-10-20T21:06:14.2388396Z +               '    #GOOD -- Verify with normalised version of path\n' +
2026-10-20T21:06:14.2388697Z +               '    fullpath = os.path.normpath(os.path.join(base_path, filename))\n' +
2026-10-20T21:06:14.2388901Z +               '    if not fullpath.startswith(base_path):\n' +
2026-10-20T21:06:14.2389217Z +               '        raise Exception("not allowed")\n' +
2026-10-20T21:06:14.2389403Z +               "    data = open(fullpath, 'rb').read()\n" +
2026-10-20T21:06:14.2389532Z +               '    return data\n' +
2026-10-20T21:06:14.2389630Z +               '\n' +
2026-10-20T21:06:14.2389718Z                 '```\n' +
