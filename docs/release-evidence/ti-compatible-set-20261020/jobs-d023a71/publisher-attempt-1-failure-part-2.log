2026-10-20T21:06:14.2386010Z +               'def user_picture2():\n' +
2026-10-20T21:06:14.2386393Z +               "    base_path = '/server/static/images'\n" +
2026-10-20T21:06:14.2386586Z +               "    filename = request.args.get('p')\n" +
2026-10-20T21:06:14.2386846Z +               '    # BAD: This could still read any file on the file system\n' +
2026-10-20T21:06:14.2387129Z +               "    data = open(os.path.join(base_path, filename), 'rb').read()\n" +
2026-10-20T21:06:14.2387265Z +               '    return data\n' +
