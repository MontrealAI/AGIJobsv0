2026-10-20T21:06:14.1944727Z +               '    dn = "dc={}".format(unsafe_dc)\n' +
2026-10-20T21:06:14.1944963Z +               '    search_filter = "(user={})".format(unsafe_filter)\n' +
2026-10-20T21:06:14.1945049Z                 '\n' +
