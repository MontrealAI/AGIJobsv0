2026-10-20T21:06:14.2893153Z -               'from flask import Flask, request, redirect\n' +
2026-10-20T21:06:14.2893258Z                 'import re\n' +
2026-10-20T21:06:14.2893344Z                 '\n' +
2026-10-20T21:06:14.2893488Z -               'app = Flask(__name__)\n' +
2026-10-20T21:06:14.2893575Z                 '\n' +
2026-10-20T21:06:14.2893728Z +               '@app.route("/direct")\n' +
2026-10-20T21:06:14.2894150Z +               'def direct():\n' +
