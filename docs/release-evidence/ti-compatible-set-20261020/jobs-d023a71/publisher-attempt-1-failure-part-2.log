2026-10-20T21:06:14.2825269Z +             'problem.severity': 'error',
2026-10-20T21:06:14.2825409Z +             'security-severity': '7.5',
2026-10-20T21:06:14.2825932Z +             description: 'Running a Flask app in debug mode may allow an attacker to run arbitrary code through the Werkzeug debugger.',
2026-10-20T21:06:14.2826066Z +             id: 'py/flask-debug',
2026-10-20T21:06:14.2826187Z +             kind: 'problem',
2026-10-20T21:06:14.2826362Z +             name: 'Flask app is run in debug mode',
2026-10-20T21:06:14.2826499Z +             precision: 'high',
2026-10-20T21:06:14.2826591Z +             tags: [
2026-10-20T21:06:14.2826694Z +               'security',
2026-10-20T21:06:14.2826837Z +               'external/cwe/cwe-215',
2026-10-20T21:06:14.2826980Z +               'external/cwe/cwe-489'
2026-10-20T21:06:14.2827064Z +             ]
