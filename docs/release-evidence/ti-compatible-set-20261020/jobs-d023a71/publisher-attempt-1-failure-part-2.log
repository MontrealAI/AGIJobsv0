2026-10-20T21:06:14.2713269Z -               'import ssl\n' +
2026-10-20T21:06:14.2713348Z                 '\n' +
2026-10-20T21:06:14.2713512Z +               'def write_results(results):\n' +
2026-10-20T21:06:14.2713770Z +               '    with NamedTemporaryFile(mode="w+", delete=False) as f:\n' +
2026-10-20T21:06:14.2714144Z +               '        f.write(results)\n' +
2026-10-20T21:06:14.2714336Z +               '    print("Results written to", f.name)\n' +
