2026-10-20T21:06:14.2328459Z -               '\n' +
2026-10-20T21:06:14.2328780Z -               '    # GOOD: A sandboxed environment is used to construct the template. \n' +
2026-10-20T21:06:14.2328957Z -               '    t = env.from_string(template)\n' +
2026-10-20T21:06:14.2329045Z -               '\n' +
2026-10-20T21:06:14.2329218Z -               "    name = request.GET['name']\n" +
2026-10-20T21:06:14.2329404Z -               '    html = t.render(name=escape(name))\n' +
2026-10-20T21:06:14.2329566Z -               '    return HttpResponse(html)\n' +
2026-10-20T21:06:14.2329661Z -               '\n' +
2026-10-20T21:06:14.2329754Z -               '\n' +
2026-10-20T21:06:14.2329889Z -               'urlpatterns = [\n' +
2026-10-20T21:06:14.2330024Z -               "    path('a', a),\n" +
2026-10-20T21:06:14.2330116Z -               ']\n' +
2026-10-20T21:06:14.2330215Z -               '```\n' +
2026-10-20T21:06:14.2330436Z -               '\n' +
2026-10-20T21:06:14.2330563Z -               '## References\n' +
