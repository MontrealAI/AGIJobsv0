2026-10-20T21:06:14.2339031Z                 '\n' +
2026-10-20T21:06:14.2339259Z -               '    # BAD: Template is constructed from user input. \n' +
2026-10-20T21:06:14.2339424Z -               '    t = Template(template)\n' +
