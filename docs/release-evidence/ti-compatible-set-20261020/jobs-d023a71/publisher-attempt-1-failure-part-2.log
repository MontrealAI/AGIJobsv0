2026-10-20T21:06:14.2926773Z +               '    re.search(safe_pattern, "")\n' +
2026-10-20T21:06:14.2926865Z +               '\n' +
2026-10-20T21:06:14.2926963Z +               '\n' +
2026-10-20T21:06:14.2927117Z +               '@app.route("/compile")\n' +
2026-10-20T21:06:14.2927245Z +               'def compile():\n' +
2026-10-20T21:06:14.2927450Z +               "    unsafe_pattern = request.args['pattern']\n" +
2026-10-20T21:06:14.2927660Z +               '    safe_pattern = re.escape(unsafe_pattern)\n' +
2026-10-20T21:06:14.2927875Z +               '    compiled_pattern = re.compile(safe_pattern)\n' +
2026-10-20T21:06:14.2928048Z +               '    compiled_pattern.search("")\n' +
2026-10-20T21:06:14.2928263Z +               '\n' +
2026-10-20T21:06:14.2928367Z +               '```\n' +
2026-10-20T21:06:14.2928462Z +               '\n' +
