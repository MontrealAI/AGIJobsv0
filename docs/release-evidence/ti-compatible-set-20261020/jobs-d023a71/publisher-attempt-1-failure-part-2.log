2026-10-20T21:06:14.2558483Z -               '    hash = hashlib.md5(certificate).hexdigest() # BAD\n' +
2026-10-20T21:06:14.2558651Z -               '    return hash == known_hash\n' +
2026-10-20T21:06:14.2558732Z                 '\n' +
2026-10-20T21:06:14.2559011Z +               '# Not safe, as "evil-example.net/example.com" would be accepted\n' +
2026-10-20T21:06:14.2559308Z -               'def certificate_matches_known_hash_good(certificate, known_hash):\n' +
2026-10-20T21:06:14.2559560Z -               '    hash = hashlib.sha256(certificate).hexdigest() # GOOD\n' +
