2026-10-20T21:06:14.3005758Z +               '    raise ValueError("Input too long")\n' +
2026-10-20T21:06:14.3005853Z +               '\n' +
2026-10-20T21:06:14.3006167Z +               "match = re.search(r'^(\\+|-)?(\\d+|(\\d*\\.\\d*))?(E|e)?([-+])?(\\d+)?$', str) \n" +
