2026-10-20T21:06:14.2384123Z                 '\n' +
2026-10-20T21:06:14.2384297Z +               '@app.route("/user_picture1")\n' +
2026-10-20T21:06:14.2384450Z +               'def user_picture1():\n' +
2026-10-20T21:06:14.2384640Z +               "    filename = request.args.get('p')\n" +
2026-10-20T21:06:14.2384877Z +               '    # BAD: This could read any file on the file system\n' +
2026-10-20T21:06:14.2385067Z +               "    data = open(filename, 'rb').read()\n" +
2026-10-20T21:06:14.2385206Z +               '    return data\n' +
2026-10-20T21:06:14.2385349Z -               "@app.route('/crash')\n" +
2026-10-20T21:06:14.2385478Z -               'def main():\n' +
