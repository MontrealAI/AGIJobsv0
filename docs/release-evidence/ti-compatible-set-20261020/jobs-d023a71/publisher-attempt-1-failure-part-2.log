2026-10-20T21:06:14.1751486Z -               '    client.connect("example.com")\n' +
2026-10-20T21:06:14.1751573Z                 '\n' +
2026-10-20T21:06:14.1751705Z +               'COMMANDS = {\n' +
2026-10-20T21:06:14.1751834Z +               '    "list" :"ls",\n' +
2026-10-20T21:06:14.1751975Z +               '    "stat" : "stat"\n' +
2026-10-20T21:06:14.1752066Z +               '}\n' +
