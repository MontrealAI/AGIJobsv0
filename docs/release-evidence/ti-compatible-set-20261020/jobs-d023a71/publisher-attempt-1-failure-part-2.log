2026-10-20T21:06:14.3230312Z -               "    return 'bad2'\n" +
2026-10-20T21:06:14.3230409Z -               '\n' +
2026-10-20T21:06:14.3230557Z -               "@app.route('/bad3')\n" +
2026-10-20T21:06:14.3230688Z -               'def bad3():\n' +
2026-10-20T21:06:14.3230865Z -               "    name = request.args.get('name')\n" +
2026-10-20T21:06:14.3231096Z -               "    request_logger.warn('User name: ' + name) # Bad\n" +
2026-10-20T21:06:14.3231235Z -               "    return 'bad3'\n" +
2026-10-20T21:06:14.3231325Z -               '\n' +
