2026-10-20T21:06:14.8070330Z -               '        application.main()\n' +
2026-10-20T21:06:14.8070494Z -               '    except Exception as ex:\n' +
2026-10-20T21:06:14.8070627Z -               '        log(ex)\n' +
2026-10-20T21:06:14.8070775Z -               '    except SystemExit:\n' +
2026-10-20T21:06:14.8070903Z -               '        pass\n' +
