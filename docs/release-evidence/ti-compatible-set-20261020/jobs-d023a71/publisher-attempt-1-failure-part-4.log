2026-10-20T21:06:14.7940155Z +               'def call_main_program_implicit_handle_base_exception():\n' +
2026-10-20T21:06:14.7940282Z +               '    try:\n' +
2026-10-20T21:06:14.7940517Z +               '        #application.main calls sys.exit() when done.\n' +
