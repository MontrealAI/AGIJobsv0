2026-10-20T21:06:14.7963690Z +               '    security_manager.drop_privileges()\n' +
2026-10-20T21:06:14.7963990Z +               'except SecurityError:\n' +
2026-10-20T21:06:14.7964116Z +               '    pass\n' +
2026-10-20T21:06:14.7964217Z +               '# ...\n' +
