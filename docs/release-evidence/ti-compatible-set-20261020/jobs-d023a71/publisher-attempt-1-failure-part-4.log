2026-10-20T21:06:14.6699627Z -               '    def __getitem__(self, idx):\n' +
2026-10-20T21:06:14.6699778Z -               '        if self.idx < 0:\n' +
2026-10-20T21:06:14.6700055Z -               '            # BAD: Should raise a KeyError or IndexError instead.\n' +
2026-10-20T21:06:14.6700260Z -               '            raise ValueError("Invalid index")\n' +
