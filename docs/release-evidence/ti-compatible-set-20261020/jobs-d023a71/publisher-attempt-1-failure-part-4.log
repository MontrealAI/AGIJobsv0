2026-10-20T21:06:14.8088022Z +               '    except AttributeError:\n' +
2026-10-20T21:06:14.8088197Z +               '        print ("AttributeError")\n' +
2026-10-20T21:06:14.8088314Z +               '        \n' +
2026-10-20T21:06:14.8088539Z -               '        #application.main calls sys.exit() when done.\n' +
