2026-10-20T21:06:14.6691451Z -               'class A:\n' +
2026-10-20T21:06:14.6691608Z -               '    def __init__(self, a):\n' +
2026-10-20T21:06:14.6691750Z -               '        self.a = a \n' +
2026-10-20T21:06:14.6691833Z                 '\n' +
2026-10-20T21:06:14.6691992Z +               'class MyTest(TestCase):\n' +
2026-10-20T21:06:14.6692165Z -               '    def __add__(self, other):\n' +
2026-10-20T21:06:14.6692434Z -               '        # BAD: Should return NotImplemented instead of raising\n' +
2026-10-20T21:06:14.6692620Z -               '        if not isinstance(other,A):\n' +
2026-10-20T21:06:14.6692897Z -               '            raise TypeError(f"Cannot add A to {other.__class__}")\n' +
2026-10-20T21:06:14.6693072Z -               '        return A(self.a + other.a)\n' +
2026-10-20T21:06:14.6693169Z -               '\n' +
2026-10-20T21:06:14.6693303Z -               'class B:\n' +
2026-10-20T21:06:14.6693458Z -               '    def __init__(self, a):\n' +
2026-10-20T21:06:14.6693600Z -               '        self.a = a \n' +
2026-10-20T21:06:14.6693693Z -               '\n' +
2026-10-20T21:06:14.6693981Z -               '    def __add__(self, other):\n' +
2026-10-20T21:06:14.6694759Z -               '        # GOOD: Returning NotImplemented allows for the operation to fallback to other implementations to allow other classes to support adding to B.\n' +
2026-10-20T21:06:14.6694944Z -               '        if not isinstance(other,B):\n' +
