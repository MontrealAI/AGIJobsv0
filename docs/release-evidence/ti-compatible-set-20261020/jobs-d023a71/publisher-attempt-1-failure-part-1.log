2026-10-20T21:06:14.0963685Z -               "    base_path = '/server/static/images'\n" +
2026-10-20T21:06:14.0964301Z -               "    filename = request.args.get('p')\n" +
2026-10-20T21:06:14.0964768Z -               '    # BAD: This could still read any file on the file system\n' +
