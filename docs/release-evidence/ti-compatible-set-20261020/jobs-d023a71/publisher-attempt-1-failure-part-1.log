2026-10-20T21:06:14.0566183Z                 '\n' +
2026-10-20T21:06:14.0566654Z                 'app = Flask(__name__)\n' +
2026-10-20T21:06:14.0567112Z                 '\n' +
2026-10-20T21:06:14.0567586Z +               '@app.post("/upload")\n' +
2026-10-20T21:06:14.0568145Z +               'def upload():\n' +
2026-10-20T21:06:14.0568736Z +               '    xml_src = request.get_data()\n' +
2026-10-20T21:06:14.0569397Z +               '    doc = lxml.etree.fromstring(xml_src)\n' +
2026-10-20T21:06:14.0570293Z +               '    return lxml.etree.tostring(doc)\n' +
2026-10-20T21:06:14.0570956Z -               '@app.route("/full_ssrf")\n' +
2026-10-20T21:06:14.0571544Z -               'def full_ssrf():\n' +
