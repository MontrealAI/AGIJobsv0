2026-10-20T21:06:14.6047196Z +               "        return 'Point(%r, %r)' % (self._x, self._y)\n" +
2026-10-20T21:06:14.6047293Z +               '\n' +
2026-10-20T21:06:14.6047581Z +               '    def __eq__(self, other):\n' +
2026-10-20T21:06:14.6047773Z +               '        if not isinstance(other, Point):\n' +
