2026-10-20T21:06:14.6049544Z +               "        return 'ColorPoint(%r, %r)' % (self._x, self._y, self._color)\n" +
2026-10-20T21:06:14.6049645Z +               '\n' +
2026-10-20T21:06:14.6049991Z +               '#ColorPoint(0, 0, Red) == ColorPoint(0, 0, Green) should be False, but is True.\n' +
2026-10-20T21:06:14.6050156Z +               '\n' +
