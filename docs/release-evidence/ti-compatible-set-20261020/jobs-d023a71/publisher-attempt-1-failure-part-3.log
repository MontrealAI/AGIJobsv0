2026-10-20T21:06:14.4756886Z +               '        print(word)\n' +
2026-10-20T21:06:14.4757010Z -               'x = A(1)\n' +
2026-10-20T21:06:14.4757126Z -               'y = A(1)\n' +
2026-10-20T21:06:14.4757210Z                 '\n' +
