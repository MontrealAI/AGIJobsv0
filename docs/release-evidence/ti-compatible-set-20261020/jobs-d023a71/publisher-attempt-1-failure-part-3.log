2026-10-20T21:06:14.6045970Z                 '\n' +
2026-10-20T21:06:14.6046141Z +               '    def __init__(self, x, y):\n' +
2026-10-20T21:06:14.6046284Z +               '        self._x = x\n' +
2026-10-20T21:06:14.6046415Z +               '        self._y = y\n' +
2026-10-20T21:06:14.6046565Z -               'def match_data(data):\n' +
