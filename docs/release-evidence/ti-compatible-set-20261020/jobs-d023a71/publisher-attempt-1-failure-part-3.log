2026-10-20T21:06:14.5800379Z +           id: 'py/missing-call-to-delete',
2026-10-20T21:06:14.5800541Z +           name: 'py/missing-call-to-delete',
2026-10-20T21:06:14.5800710Z -           id: 'py/super-not-enclosing-class',
2026-10-20T21:06:14.5800884Z -           name: 'py/super-not-enclosing-class',
2026-10-20T21:06:14.5800978Z             properties: {
2026-10-20T21:06:14.5801111Z               'problem.severity': 'error',
2026-10-20T21:06:14.5801230Z               'sub-severity': 'low',
2026-10-20T21:06:14.5801807Z +             description: 'An omitted call to a superclass `__del__` method may lead to class instances not being cleaned up properly.',
2026-10-20T21:06:14.5801971Z +             id: 'py/missing-call-to-delete',
2026-10-20T21:06:14.5802474Z -             description: 'Calling super with something other than the enclosing class may cause incorrect object initialization.',
2026-10-20T21:06:14.5802641Z -             id: 'py/super-not-enclosing-class',
2026-10-20T21:06:14.5802753Z               kind: 'problem',
2026-10-20T21:06:14.5803039Z +             name: 'Missing call to superclass `__del__` during object destruction',
2026-10-20T21:06:14.5803276Z -             name: 'First argument to super() is not enclosing class',
2026-10-20T21:06:14.5803392Z               precision: 'high',
2026-10-20T21:06:14.5803473Z               tags: [
2026-10-20T21:06:14.5803569Z                 'quality',
2026-10-20T21:06:14.5803679Z                 'reliability',
2026-10-20T21:06:14.5803916Z                 'correctness',
