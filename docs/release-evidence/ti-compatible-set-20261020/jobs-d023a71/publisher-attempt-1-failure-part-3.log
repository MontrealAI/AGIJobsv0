2026-10-20T21:06:14.6570257Z           },
2026-10-20T21:06:14.6570341Z           {
2026-10-20T21:06:14.6570460Z             defaultConfiguration: {
2026-10-20T21:06:14.6570558Z               enabled: true,
2026-10-20T21:06:14.6570660Z +             level: 'note'
