2026-10-20T21:06:14.4408886Z +               'try:\n' +
2026-10-20T21:06:14.4409007Z +               '    True\n' +
2026-10-20T21:06:14.4409152Z +               'except NameError:\n' +
2026-10-20T21:06:14.4409314Z +               '    __builtins__.True = 1==1\n' +
2026-10-20T21:06:14.4409689Z -               '#Attribute set in both superclass and subclass\n' +
2026-10-20T21:06:14.4409842Z -               'class C(object):\n' +
2026-10-20T21:06:14.4409923Z                 '\n' +
