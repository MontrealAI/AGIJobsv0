2026-10-20T21:06:14.4487346Z +               '        self.car_init()\n' +
2026-10-20T21:06:14.4487484Z -               'def show(obj):\n' +
2026-10-20T21:06:14.4487618Z -               '    print (obj)\n' +
2026-10-20T21:06:14.4487718Z -               '    \n' +
2026-10-20T21:06:14.4487860Z -               'class C(object):\n' +
2026-10-20T21:06:14.4487958Z -               '    \n' +
