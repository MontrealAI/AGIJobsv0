2026-10-20T21:06:14.6164706Z -           id: 'py/regex/incomplete-special-group',
2026-10-20T21:06:14.6164906Z -           name: 'py/regex/incomplete-special-group',
2026-10-20T21:06:14.6165005Z             properties: {
2026-10-20T21:06:14.6165155Z +             'problem.severity': 'error',
2026-10-20T21:06:14.6165298Z +             'sub-severity': 'low',
2026-10-20T21:06:14.6165747Z +             description: 'Using property descriptors in old-style classes does not work from Python 2.1 onward.',
2026-10-20T21:06:14.6165924Z +             id: 'py/property-in-old-style-class',
2026-10-20T21:06:14.6166092Z -             'problem.severity': 'warning',
2026-10-20T21:06:14.6166234Z -             'sub-severity': 'high',
2026-10-20T21:06:14.6166754Z -             description: 'Incomplete special groups are parsed as normal groups and are unlikely to match the intended strings.',
