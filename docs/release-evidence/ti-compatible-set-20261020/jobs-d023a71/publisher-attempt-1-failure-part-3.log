2026-10-20T21:06:14.4339057Z +               '    if unlikely_condition():\n' +
2026-10-20T21:06:14.4339242Z +               '        return the_format.format(1, 2)\n' +
2026-10-20T21:06:14.4339395Z +               '    else:\n' +
2026-10-20T21:06:14.4339633Z +               '        return the_format.format(1, 2, 3)\n' +
