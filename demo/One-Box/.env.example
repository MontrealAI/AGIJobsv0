# === Core blockchain connectivity ===
# Connected local/test deployment only. Offline --demo needs no .env.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Deployed AGI Jobs job registry contract address
JOB_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# Set actual deployed addresses for strict owner/pause diagnostics. Blank does not imply a safe default.
STAKE_MANAGER_ADDRESS=
SYSTEM_PAUSE_ADDRESS=
# Optional: agent identity (EOA or ENS) monitored by the gateway utilities
AGENT_ADDRESS=

# === Relayer credentials ===
# Private key for the orchestrator relayer (0x-prefixed hex). Fund with gas + AGIALPHA.
ONEBOX_RELAYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
# Required API bearer token (16+ characters). Generate a random secret; never put it in a URL.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ONEBOX_API_TOKEN=

# === Demo runtime ===
# Local ports for the orchestrator API and the static UI.
ONEBOX_HOST=127.0.0.1
ONEBOX_PORT=8080
ONEBOX_UI_PORT=4173
# Hostname the UI server binds to (127.0.0.1 keeps it local-only).
ONEBOX_UI_HOST=127.0.0.1
# Prefix for the orchestrator endpoints. Most deployments use /onebox.
ONEBOX_PUBLIC_ONEBOX_PREFIX=/onebox
# Optional: externally accessible orchestrator URL (defaults to http://127.0.0.1:8080).
ONEBOX_PUBLIC_ORCHESTRATOR_URL=
# Optional: block explorer base for transaction links.
ONEBOX_EXPLORER_TX_BASE=
# UI default mode: guest (walletless) or expert.
ONEBOX_UI_DEFAULT_MODE=guest
# Optional: override the welcome banner inside the chat history.
ONEBOX_UI_WELCOME=
# Optional: pipe-separated, newline-separated, or JSON array of shortcut prompts.
ONEBOX_UI_SHORTCUTS=

# === Organisational guardrails ===
# Maximum reward budget (AGIALPHA) a single job may allocate. Leave blank to disable the cap.
ONEBOX_MAX_JOB_BUDGET_AGIA=
# Maximum job duration in days enforced by the demo orchestrator. Leave blank to accept contract defaults.
ONEBOX_MAX_JOB_DURATION_DAYS=

# === IPFS + receipts (optional) ===
# Configure a pinning gateway if you want the orchestrator to pin job specs/receipts.
PINNER_HOST=
PINNER_JWT=
PINNER_KEY=
PINNER_SECRET=

# === Real connected providers (not needed for preview) ===
# Planner REST endpoint and credential expected by PlannerClient.
ALPHA_ORCHESTRATOR_URL=
ALPHA_ORCHESTRATOR_TOKEN=
# Reachable IPFS HTTP API; no pinning service is started by this demo.
IPFS_API_URL=http://127.0.0.1:5001/api/v0
