########################################################################
# ⚙️ Core chain + keys
########################################################################

# Local JSON-RPC endpoint. The docker-compose stack exposes Anvil at this URL.
RPC_URL=http://culture-chain:8545

# Chain ID for the local Anvil network.
CHAIN_ID=31337

# Default Hardhat deployer key (DO NOT USE IN PRODUCTION!).
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Optional dedicated key for seeding artifacts; falls back to DEPLOYER_PRIVATE_KEY.
SEEDER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Owner account that will administer CultureRegistry and SelfPlayArena.
OWNER_ADDRESS=0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266

########################################################################
# 📦 AGI Jobs v0 (v2) integration points
########################################################################

# JSON blob with the upstream platform addresses expected by the demo scripts.
# Example (local mock contracts):
# {"jobRegistry":"0x0000000000000000000000000000000000000001","validationModule":"0x0000000000000000000000000000000000000002","stakeManager":"0x0000000000000000000000000000000000000003","identityRegistry":"0x0000000000000000000000000000000000000004"}
AGI_JOBS_CORE_ADDRESSES={"jobRegistry":"0x0000000000000000000000000000000000000001","validationModule":"0x0000000000000000000000000000000000000002","stakeManager":"0x0000000000000000000000000000000000000003","identityRegistry":"0x0000000000000000000000000000000000000004"}

# Output file for deployment scripts to persist addresses for other services.
CULTURE_DEPLOY_OUTPUT=demo/CULTURE-v0/config/deployments.local.json

# Optional path to the .env file that should be patched with deployment results.
CULTURE_ENV_FILE=demo/CULTURE-v0/.env

########################################################################
# 🔐 Contracts populated by deploy.culture.ts (auto-written)
########################################################################

CULTURE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
SELF_PLAY_ARENA_ADDRESS=0x0000000000000000000000000000000000000000

########################################################################
# 🌐 Off-chain services
########################################################################

# IPFS gateway + API credentials. When running docker compose the gateway is
# exposed as http://localhost:8080 and the API at http://localhost:5001.
IPFS_GATEWAY=http://localhost:8080
IPFS_API_ENDPOINT=http://culture-ipfs:5001
IPFS_API_TOKEN=
PINATA_JWT=
WEB3_STORAGE_TOKEN=

# Orchestrator tuning knobs.
# For local in-memory simulation leave SELF_PLAY_ARENA_ADDRESS empty.
# On-chain mode requires a deployed nonzero arena address, its authorized
# operator key, and an independently generated API token of at least 32 characters.
# Never enter the operator private key in the browser.
ORCHESTRATOR_PRIVATE_KEY=
ORCHESTRATOR_API_TOKEN=
ORCHESTRATOR_PORT=4005
TARGET_SUCCESS_RATE=0.6
MAX_DIFFICULTY_STEP=2
MIN_DIFFICULTY=1
MAX_DIFFICULTY=9
ROUND_TIMEOUT_MS=900000
OPERATION_TIMEOUT_MS=10000
ELO_STATE_PATH=/data/elo/ratings.json
CULTURE_ORCHESTRATOR_URL=http://culture-orchestrator:4005

# Indexer configuration.
INDEXER_PORT=4100
SQLITE_PATH=/data/db/culture-graph.db
INFLUENCE_JOB_INTERVAL=60000
POLL_INTERVAL_MS=15000
FINALITY_DEPTH=3

# Culture Studio UI wiring.
# Explicit browser-only simulation. Keep false when checking actual services.
# Vite embeds these values at build time; rebuild after changing them.
VITE_DEMO_MODE=false
VITE_ORCHESTRATOR_URL=http://localhost:4005
VITE_INDEXER_URL=http://localhost:4100/graphql
VITE_IPFS_GATEWAY=http://localhost:8080

########################################################################
# 📊 Reporting + automation
########################################################################

# Base directory for report exports generated by scripts/export.weekly.ts.
CULTURE_REPORT_OUTPUT=demo/CULTURE-v0/reports
CULTURE_ANALYTICS_OUTPUT=demo/CULTURE-v0/data/analytics
CULTURE_ANALYTICS_ALERT_LOG=demo/CULTURE-v0/logs/analytics.alerts.jsonl
CULTURE_ANALYTICS_INTERVAL=3600
CULTURE_ANALYTICS_DB=/data/db/culture-graph.db
